      "leader_name": "Muhammad Farhan Pratama",
      "vice_leader_name": "",
      "photo_url": "/assets/images/paslon_1_lead_1793677968157.jpg",
      "vision": "Mewujudkan OSIS sebagai wadah aspirasi siswa yang inklusif, adaptif terhadap teknologi digital, dan berlandaskan budi pekerti luhur.",
      "mission": [
        "Memodernisasi kegiatan ekstrakurikuler berbasis talenta abad ke-21 dan kompetisi sains/olahraga.",
        "Membuka kanal aspirasi digital \"Halo OSIS\" yang transparan, responsif, dan mudah diakses siswa.",
        "Menggalakkan gerakan peduli lingkungan \"Green & Clean School\" dan pengurangan sampah plastik di kantin.",
        "Mempererat kolaborasi lintas angkatan dan solidaritas antarkelas melalui festival seni tahunan."
      ],
      "work_programs": [
        "Pekan Kreativitas dan Inovasi Siswa (InnoFest)",
        "Digitalisasi mading sekolah dan podcast kesiswaan",
        "Workshop kepemimpinan & public speaking untuk perwakilan kelas"
      ],
      "motto": "Berkarya dengan Aksi, Memimpin dengan Hati",
      "created_at": "2026-10-20T09:00:00Z"
